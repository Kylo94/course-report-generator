# ⚠️ 已废弃：AI 配置现在通过应用「设置」页面维护
#
# 此文件仅作为旧版本升级参考，不再作为运行时配置源。
# 首次升级时，程序会读取已有的 config/llm.yaml 一次性迁移到
# data/user_settings.json（API Key 加密保存），随后旧文件不再生效。
#
# 下面是旧格式示例（仅供对照，无需编辑）：
#
# provider: deepseek
# api_key: sk-your-api-key-here
# base_url: https://api.deepseek.com/v1
# default_model: deepseek-chat
# max_tokens: 8192
# timeout: 60
# max_retries: 2
# temperature:
#   knowledge_points: 0.3
#   content_summary: 0.5
#   homework: 0.5
#   vocabulary: 0.5
#   ability_improvement: 0.5
#   evaluation: 0.9
